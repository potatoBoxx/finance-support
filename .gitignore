# ==========================================
# Streamlit & Secrets (NEVER commit secrets!)
# ==========================================
.streamlit/secrets.toml
.streamlit/secrets.toml*
!.streamlit/secrets.toml.example
**/.streamlit/secrets.toml
**/.streamlit/secrets.toml*
!**/.streamlit/secrets.toml.example

# Environment Variables & Credentials
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
service_account*.json

