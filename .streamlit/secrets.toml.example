# ==============================================================================
# Supabase 연결 설정 템플릿
# ==============================================================================
# 1. Supabase 대시보드(https://supabase.com)에 로그인 후 프로젝트를 생성합니다.
# 2. [Project Settings] > [API] 메뉴로 이동합니다.
# 3. Project URL과 Project API Keys (anon public 또는 service_role)를 아래에 입력합니다.
# 4. 이 파일의 이름을 'secrets.toml'로 변경하여 저장합니다.
#
# 주의: secrets.toml 파일은 개인 인증 정보를 포함하므로 절대 GitHub에 커밋하지 마세요!
# ==============================================================================

SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-anon-or-service-role-key"
